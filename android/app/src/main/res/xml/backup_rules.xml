<?xml version="1.0" encoding="utf-8"?>
<!--
  Armour Up Daily stores journal entries, confessions, and struggle history
  on-device only. Android Auto Backup would copy SharedPreferences to the
  user's Google Drive, so it is disabled entirely.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
